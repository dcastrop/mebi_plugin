.merlin
*.ml*.d
*.cm[ixt]*
Makefile.rocq
.Makefile.rocq.d
Makefile.rocq.conf
Makefile.coq
.Makefile.coq.d
Makefile.coq.conf
*~
*.[ao]
.coqdeps.d
.rocqdeps.d
*.vo
*.vos
*.vok
*.glob
*.aux
*/*/.merlin

# by convention g_foo.ml is generated
g_*.ml

# ignore dune stuff
_build
# Do NOT ignore *.opam. rocq-mebi.opam is generated by dune from dune-project
# (generate_opam_files), and dune expects it to be checked in. It is also the input
# to `opam switch create .`, so with it ignored a fresh clone has no package
# definition to bootstrap the switch from.
# https://dune.readthedocs.io/en/stable/reference/dune-project/generate_opam_files.html
# *.opam
dune.lock

# ignore generated make files
CoqMakeFile*
CoqMakefile*
.CoqMakeFile.d
RocqMakeFile*
RocqMakefile*
.RocqMakeFile.d

# ignore vscode settings
.vscode
.claude

# ignore dumps
**/_dumps
src/_dump
src/commandOLDunify.ml
