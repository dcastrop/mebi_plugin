.merlin
*.ml*.d
*.cm[ixt]*
*.cm[oa]
Makefile.rocq
.Makefile.rocq.d
Makefile.rocq.conf
Makefile.coq
.Makefile.coq.d
Makefile.coq.conf
*~
*.[ao]
.coqdeps.d
.rocqdeps.d
*.vo
*.vos
*.vok
*.glob
*.aux
*/*/.merlin

# by convention g_foo.ml is generated
g_*.ml

# ignore dune stuff
_build
# the local opam switch (README, "Toolchain")
_opam/
# Do NOT ignore *.opam. rocq-mebi.opam is generated by dune from dune-project
# (generate_opam_files), and dune expects it to be checked in. It is also the input
# to `opam switch create .`, so with it ignored a fresh clone has no package
# definition to bootstrap the switch from.
# https://dune.readthedocs.io/en/stable/reference/dune-project/generate_opam_files.html
# *.opam
dune.lock

# ignore generated make files
CoqMakeFile*
CoqMakefile*
.CoqMakeFile.d
RocqMakeFile*
RocqMakefile*
.RocqMakeFile.d

# ignore vscode settings
.vscode
.claude

# ignore dumps
**/_dumps
# bench/verdicts.py
/_verdicts
/_certify
/_optionb
src/_dump
.lia.cache

# LaTeX build outputs (doc/*.tex, e.g. built in place by LaTeX Workshop)
doc/*.pdf
doc/*.log
doc/*.fls
doc/*.fdb_latexmk
doc/*.synctex.gz

# LaTeX build files of doc/report (the .tex sources are tracked)
doc/report/*.fdb_latexmk
doc/report/*.fls
doc/report/*.log
doc/report/*.out
doc/report/*.toc
doc/report/*.synctex.gz
doc/report/main.pdf

# the report's bibliography outputs (the report itself, doc/report/main.pdf,
# is ignored above: build it with pdflatex main; bibtex main; pdflatex main;
# pdflatex main)
doc/report/main.bbl
doc/report/main.blg

# the plugin's files for a file F.v, next to it: Sylvan's proof logs (Set
# MeBi Log Mode; doc/certificate.md) and a proof's temporary files
.*.v.mebi/
__pycache__/
