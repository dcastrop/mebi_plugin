# Exact version, matched by the :with-dev-setup constraint in dune-project.
# ocamlformat refuses to run on a mismatch rather than silently reformatting.
version = 0.29.0
profile = janestreet
margin=80
max-indent = 2
break-cases = fit
parse-docstrings = true
wrap-comments = true
# wrap-fun-args = false
# break-fun-decl = fit-or-vertical
# break-fun-sig = fit-or-vertical

# the issue with over-indenting is here: https://github.com/ocaml-ppx/ocamlformat/issues/1116
