; Links rocq-mebi.model only -- no plugin, no rocq-runtime. If this stops
; building because a Rocq dependency crept back into lib/utils, lib/terms or
; lib/model, that is the regression this target exists to catch.
;
; No (public_name): this is a test binary, and installing it would drop it into
; the opam switch's bin/.
(test
 (name tests)
 (modules tests)
 (libraries rocq-mebi.model))

; Throwaway scaling probe for the saturation algorithm (see satscale.ml).
; Same constraint as the test binary above: model only, no rocq-runtime.
(executable
 (name satscale)
 (modules satscale)
 (libraries rocq-mebi.model unix))
