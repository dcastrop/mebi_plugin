; Named to match its sole module (Type_): this is what makes dune collapse
; the wrapper to a bare [Type_], matching how `make`'s flat, unwrapped build
; (_CoqProject has no library concept at all) sees it from
; set_.ml/showable.ml -- if the names didn't match,
; dune would require the cross-library reference `Showable_.Type_`, which
; `make` has no equivalent of.
(library
 (name type_)
 (public_name rocq-mebi.showable.type)
 (modules Type_)
 (wrapped true))

(library
 (name showable)
 (public_name rocq-mebi.showable)
 (libraries rocq-mebi.showable.type)
 (modules Set_ Showable)
 (wrapped true))

; Unifies Showable's pp/show/equal/compare with the JSON-dump mechanism
; (lib/utils/json.ml). Kept as its own library, rather than folded into
; "showable" above, so that library never has to depend on rocq-mebi.utils.
; (The reason this was first needed is gone: rocq-mebi.showable.type also
; exported a top-level [Json], which made the name ambiguous; that module,
; and lib/json with it, were unused and removed on 2026-10-09.)
(library
 (name thing)
 (public_name rocq-mebi.showable.thing)
 (libraries rocq-mebi.utils rocq-mebi.showable)
 (modules Thing)
 (wrapped false))

(include_subdirs no)
