; Deliberately no rocq-runtime dependency: plain OCaml. Routing output to
; Rocq's Feedback is done by installing a sink (Logger.set_sink) from src/,
; which is where rocq-runtime does belong.
(library
 (name utils)
 (public_name rocq-mebi.utils)
 (modules output logger)
 (wrapped false))

(include_subdirs no)
