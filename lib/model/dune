; No rocq-runtime and no rocq_tools: the model is plain OCaml over an
; abstract element type, and must stay linkable from test/ without a Rocq
; runtime. Info.Make takes its constructor-bindings parameter as a Json.S
; rather than a Constructor_bindings.S for exactly this reason.
;
; All 17 mutually-referential model components (State, Label, Action, Edge,
; ...) live nested inside one functor in components.ml, rather than each in
; its own file/library -- see notes/3-collapse-model-component-cluster.md.

(library
 (name components)
 (public_name rocq-mebi.model.components)
 (libraries rocq-mebi.utils rocq-mebi.terms yojson)
 (modules components)
 (wrapped false))

(library
 (name lts)
 (public_name rocq-mebi.model.lts)
 (libraries
  rocq-mebi.utils
  rocq-mebi.terms
  rocq-mebi.model.components
  yojson)
 (modules LTS)
 (wrapped false))

(library
 (name fsm)
 (public_name rocq-mebi.model.fsm)
 (libraries
  rocq-mebi.utils
  rocq-mebi.terms
  rocq-mebi.model.components
  rocq-mebi.model.lts
  rocq-mebi.model.wip
  rocq-mebi.model.algorithms.saturation
  yojson)
 (modules FSM)
 (wrapped false))

(library
 (name model)
 (public_name rocq-mebi.model)
 (libraries
  rocq-mebi.utils
  rocq-mebi.terms
  rocq-mebi.model.components
  rocq-mebi.model.lts
  rocq-mebi.model.wip
  rocq-mebi.model.fsm
  rocq-mebi.model.algorithms
  yojson)
 (modules model)
 (wrapped false))

