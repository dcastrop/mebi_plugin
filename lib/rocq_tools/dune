; Rocq helpers: the small functions lib/rules and the tactics share.
(library
 (name rocq_tools)
 (public_name rocq-mebi.rocq_tools)
 (libraries
  rocq-runtime.vernac
  rocq-runtime.plugins.ltac
  rocq-mebi.utils)
 ; cppo: the code that differs between Rocq 9.2 and 9.3 is under
 ; #if ROCQ_VERSION; a file that gains one goes here and in
 ; .ocamlformat-ignore.
 (preprocess
  (per_module
   ((action
     (run %{bin:cppo} -V ROCQ:%{rocq:version.major}.%{rocq:version.minor}.0 %{input-file}))
    rocq_utils)))
 (modules rocq_utils)
 (wrapped false))
