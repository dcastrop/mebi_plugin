{
open Ltac_plugin
open Tacarg

(* [lconstr], a term up to the end of the command *)
open Extraargs

(* This one is necessary, to avoid message about missing wit_string *)
open Stdarg

(* lib/ emits through Logger, which prints to stdout until a sink is installed.
   Route it through Rocq's Feedback now that we are running inside Rocq. *)
let () = Rocq_output.install ()

(* Said once, when Rocq loads the plugin ([Require Import MEBI.loader]): where
   the commands are listed, and how to see the routine messages. A [Notice],
   so it is shown by default. *)
let () =
  Logger.notice
    "(MeBi loaded. [MeBi Help.] lists the commands; [Set Debug \"mebi-info\".] \
     shows routine progress messages.)"
}

DECLARE PLUGIN "rocq-mebi.mebi"

(* the rules the engine reads from an LTS's constructors, for debugging *)
VERNAC COMMAND EXTEND MeBi_Print_Rules CLASSIFIED AS QUERY
| [ "Print" "MeBi" "Rules" reference(r) ] ->
  { let env = Global.env () in
    let sigma = Evd.from_env env in
    match Nametab.global r with
    | Names.GlobRef.IndRef ind ->
      (match Rules.of_lts env sigma ind with
       | ltss -> Feedback.msg_notice (Rules.pr env sigma ltss)
       | exception Rules.Not_an_lts i ->
         CErrors.user_err
           Pp.(Printer.pr_global (Names.GlobRef.IndRef i)
               ++ str " is not an LTS: an inductive [M -> option A -> M -> Prop] without parameters.")
       | exception Rules.Decidable_not_loaded ->
         CErrors.user_err
           (Pp.str "Stdlib's Decidable class is not loaded: [Require MEBI.loader.] loads it."))
    | _ -> CErrors.user_err Pp.(Libnames.pr_qualid r ++ str " is not an inductive.") }
END

(* doc/skeleton.md: a start term's skeleton,
   positions and summands, for debugging. *)
VERNAC COMMAND EXTEND MeBi_Print_Skeleton CLASSIFIED AS QUERY
| [ "Print" "MeBi" "Skeleton" constr(t) "Using" reference(r) ] ->
  { let env = Global.env () in
    let sigma = Evd.from_env env in
    match Nametab.global r with
    | Names.GlobRef.IndRef ind ->
      let v, _ = Constrintern.interp_constr env sigma t in
      (match Skeleton.build env sigma ind (EConstr.to_constr sigma v) with
       | s -> Feedback.msg_notice (Skeleton.pr env sigma s)
       | exception Rules.Not_an_lts i ->
         CErrors.user_err
           Pp.(Printer.pr_global (Names.GlobRef.IndRef i)
               ++ str " is not an LTS: an inductive [M -> option A -> M -> Prop] without parameters.")
       | exception Rules.Decidable_not_loaded ->
         CErrors.user_err (Pp.str "Stdlib's Decidable class is not loaded."))
    | _ -> CErrors.user_err Pp.(Libnames.pr_qualid r ++ str " is not an inductive.") }
END

(* doc/certificate.md, A: the records of a proof log (a file
   [Set MeBi Log Mode "keep"] left) as facts, each chunk its own constant,
   checked when declared. *)
VERNAC COMMAND EXTEND MeBi_Check_Log CLASSIFIED AS SIDEFF
| [ "MeBi" "Check" "Log" string(file) ] -> { User_tactics.check_log file }
END

(* [MeBi Prove id : goal.]: the lemma [id], proved from the certificate as
   the tactics prove a goal, each piece of the proof a global constant
   checked when declared (doc/certificate.md, "Large goals"): for
   large goals, in less memory than [Proof. weak_sim. Qed.]. *)
VERNAC COMMAND EXTEND MeBi_Prove CLASSIFIED AS SIDEFF
| [ "MeBi" "Prove" ident(id) ":" lconstr(c) ] -> { User_tactics.prove_command id c }
END

(* Structural congruence by hand (doc/upto.md): the silent rules of an
   LTS to take as its structural congruence, instead of the reorderings
   found in its rules ([Print MeBi Skeleton] shows which); for proofs up
   to congruence (doc/optimisations.md, 5). *)
VERNAC COMMAND EXTEND MeBi_Congruence CLASSIFIED AS SIDEFF
| [ "MeBi" "Congruence" reference(r) ne_ident_list(ids) ] ->
  { match Nametab.global r with
    | Names.GlobRef.IndRef ind ->
      let env = Global.env () in
      let _, mip = Inductive.lookup_mind_specif env ind in
      let cons = Array.to_list mip.Declarations.mind_consnames in
      List.iter
        (fun id ->
          if Bool.not (List.exists (Names.Id.equal id) cons)
          then
            CErrors.user_err
              Pp.(str "MeBi Congruence: " ++ Names.Id.print id
                  ++ str " is not a rule of " ++ Libnames.pr_qualid r ++ str "."))
        ids;
      Skeleton.set_congruence ind ids;
      Feedback.msg_notice
        Pp.(str "MeBi Congruence: " ++ Libnames.pr_qualid r ++ str ": "
            ++ prlist_with_sep pr_comma Names.Id.print ids ++ str ".")
    | _ ->
      CErrors.user_err
        Pp.(Libnames.pr_qualid r ++ str " is not an inductive.") }
END

(* [sim], [bisim]: a [strong_sim] or [strong_bisimilar] goal; [weak_sim],
   [weak_bisim]: a [weak_sim] or [weak_bisimilar] goal. Decided by the
   engine on Sylvan's diagrams, the certificate logged by Sylvan
   ([User_tactics], doc/certificate.md). [debug] first: the engine's report
   is printed too. *)
TACTIC EXTEND MeBi_bisim
| [ "bisim" ] -> { User_tactics.prove ~weak:false User_tactics.Bisim }
| [ "debug" "bisim" ] ->
  { User_tactics.prove ~debug:true ~weak:false User_tactics.Bisim }
END

TACTIC EXTEND MeBi_sim
| [ "sim" ] -> { User_tactics.prove ~weak:false User_tactics.Sim }
| [ "debug" "sim" ] ->
  { User_tactics.prove ~debug:true ~weak:false User_tactics.Sim }
END

TACTIC EXTEND MeBi_weak_bisim
| [ "weak_bisim" ] -> { User_tactics.prove ~weak:true User_tactics.Bisim }
| [ "debug" "weak_bisim" ] ->
  { User_tactics.prove ~debug:true ~weak:true User_tactics.Bisim }
END

TACTIC EXTEND MeBi_weak_sim
| [ "weak_sim" ] -> { User_tactics.prove ~weak:true User_tactics.Sim }
| [ "debug" "weak_sim" ] ->
  { User_tactics.prove ~debug:true ~weak:true User_tactics.Sim }
END

(* Help -- topics and text in [src/help.ml] *)
VERNAC COMMAND EXTEND MeBi_Help CLASSIFIED AS QUERY
| ["MeBi" "Help"] -> { Help.show [] }
| ["MeBi" "Help" "Debug"] -> { Help.show [ "Debug" ] }
| ["MeBi" "Help" "Sim"] -> { Help.show [ "Sim" ] }
| ["MeBi" "Help" "Output"] -> { Help.show [ "Output" ] }
END

VERNAC COMMAND EXTEND MeBi_Divider CLASSIFIED AS QUERY
(* for outputting messages -- useful for sifting through compiler output *)
| ["MeBi" "Message" string(x)] -> {Feedback.msg_info (Pp.str x)}
| ["MeBi" "Debug"   string(x)] -> { Logger.debug x }
| ["MeBi" "Divider"          ] -> {Feedback.msg_info (Pp.str "\n- - - - - - - - - - - - - - - -")}
| ["MeBi" "Divider" string(x)] -> {Feedback.msg_info (Pp.str (Printf.sprintf "\n- - - - - - - - - - - - - - - -\n%s" x))}
END 
