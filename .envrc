use flake

# Only activate the switch once it exists -- on a fresh clone it does not, and
# `opam env` would error. The flake's shellHook prints (and can run) the
# bootstrap command in that case.
if [ -d "$PWD/_opam" ]; then
  eval "$(opam env --switch="$PWD" --set-switch)"
fi

# nix-direnv already watches flake.nix/flake.lock; reload when the pinned
# dependency set changes too.
watch_file rocq-mebi.opam.locked
