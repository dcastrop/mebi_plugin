; The examples, as the theory MEBI.Examples. Built by `dune build` and CI;
; not part of the opam package (no (package ...)), like test/rocq.
;
; Each goal is decided, its certificate logged by Sylvan, and the goal
; closed by the proof built from it, checked by the kernel at Qed
; (doc/certificate.md). Only the files listed
; are built. The others, CADP/TwoProcesses.v, CADP/ThreeProcesses.v
; (5 minutes, 6.6GB) and Proc/Test4/TermTests.v: bench/prooflog.py runs
; them, each step under a memory cap (bench/README.md).

(rocq.theory
 (name MEBI.Examples)
 (synopsis "MEBI plugin examples")
 (plugins rocq-mebi.mebi)
 (stdlib yes)
 (theories Stdlib MEBI)
 (modules
  ; CCS (value-free, Milner 1989): textbook pairs and the Alternating Bit
  ; Protocol
  CCS
  Bisimilarity.CCS.PluginProofs
  ; Proc: Test1-3 (Test4's terms; its goals, TermTests.v, not built)
  Proc
  Bisimilarity.Proc.Test1.Terms
  Bisimilarity.Proc.Test2.Terms
  Bisimilarity.Proc.Test3.Terms
  Bisimilarity.Proc.Test4.Terms
  Bisimilarity.Proc.Test1.PluginProofs
  Bisimilarity.Proc.Test2.PluginProofs
  Bisimilarity.Proc.Test3.PluginProofs
  ; CADP: the MCS queue lock against the lock server, one process
  ; (TwoProcesses.v, ThreeProcesses.v: bench/prooflog.py, not built)
  CADP.Model
  CADP.SpecMutex
  CADP.Terms
  CADP.MutualExclusion))

(include_subdirs qualified)
