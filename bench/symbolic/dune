; SYMBOLIC_PLAN.md, phase S0: a standalone prototype of the symbolic
; route, outside the plugin (see README.md here). Links rocq-mebi.model,
; for the explicit oracle, as bench/ocaml does, and CUDD through opam's
; mlcuddidl. Nothing here is installed.

(library
 (name symbolic_core)
 (modules bdd network symbolic explicit families driver)
 (wrapped false)
 (libraries rocq-mebi.model yojson unix))

; Only where mlcuddidl is installed; skipped elsewhere (CI does not have it).
(executable
 (name main)
 (modules bdd_cudd main)
 (optional)
 (libraries symbolic_core cudd))
